{
  "name": "ehs-mexico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
