# Opcional. Copiar a .env para desarrollo local; nunca guardar credenciales en Git.
HOST=127.0.0.1
PORT=3000
EHS_DB_PATH=data/ehs.sqlite
# Sin clave, el consultor funciona en modo de recuperación extractiva.
EHS_AI_API_KEY=
EHS_AI_MODEL=gpt-4.1-mini
# Desarrollo local: sin contraseña compartida. Para un piloto web usar 1 y
# configurar usuario/contraseña (mínimo 16 caracteres) en el hosting, fuera de Git.
EHS_REQUIRE_PILOT_AUTH=0
EHS_PILOT_USER=
EHS_PILOT_PASSWORD=
